## Error Handling and Logging

### 18. Error Handling and JSON Serialization Patterns
```python
# Frontend error handling
try:
    response = requests.post(webhook_url, json=payload)
    if response.status_code == 200:
        # Handle success
        pass
    else:
        st.error(f"Error: {response.status_code}")
except requests.exceptions.RequestException as e:
    st.error(f"Connection error: {str(e)}")

# JSON Serialization for datetime objects
def serialize_datetime(obj):
    """Helper function to serialize datetime objects for JSON"""
    if isinstance(obj, datetime):
        return obj.isoformat()
    raise TypeError(f"Object of type {type(obj)} is not JSON serializable")

# Usage in payload preparation
chat_history_serialized = []
for msg in chat_history:
    msg_copy = msg.copy()
    if 'timestamp' in msg_copy and isinstance(msg_copy['timestamp'], datetime):
        msg_copy['timestamp'] = msg_copy['timestamp'].isoformat()
    chat_history_serialized.append(msg_copy)

# Backend error handling
@api_view(['POST'])
def endpoint(request):
    try:
        # Process request
        return Response(data, status=status.HTTP_200_OK)
    except Exception as e:
        return Response(
            {'error': str(e)}, 
            status=status.HTTP_500_INTERNAL_SERVER_ERROR
        )
```

