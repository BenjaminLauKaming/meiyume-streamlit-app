# ===========================================
# AZURE AD AUTHENTICATION
# ===========================================
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production (uncomment and configure for production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# AWS S3 (for production)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ===========================================
# MONITORING AND LOGGING
# ===========================================
# Sentry for error tracking (production)
SENTRY_DSN=your-sentry-dsn-here

# Logging Level
LOG_LEVEL=INFO

# ===========================================
# PRODUCTION ONLY SETTINGS
# ===========================================
# These should only be set in production

# Security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Domain configuration for production
DOMAIN_NAME=yourdomain.com

# ===========================================
# ADDITIONAL RUNTIME CONFIGURATION
# ===========================================
# Django API URL (for Streamlit)
DJANGO_API_URL=http://localhost:8000

# Site Domain (for production file URLs)
SITE_DOMAIN=https://your-domain.com

# Development Settings
STREAMLIT_SERVER_PORT=8501
DJANGO_SERVER_PORT=8000
N8N_SERVER_PORT=5678 