# Environment Configuration Template
# Copy this file to .env and fill in your values

# ===========================================
# ENVIRONMENT TYPE
# ===========================================
# Options: development, production
ENVIRONMENT=development

# ===========================================
# DJANGO CONFIGURATION
# ===========================================
SECRET_KEY='(1t1io)0th*lt-ri4vi!y&nmdh1rqhi4!mw*msq-&(cu0gd+f#'
DEBUG=True
DJANGO_SETTINGS_MODULE=ai_cad_analyzer.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Option 1: Use DATABASE_URL (recommended)
DATABASE_URL=postgresql://cad_user:cad_password@localhost:5432/cad_analyzer_dev

# Option 2: Individual database settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cad_analyzer_dev
DB_USER=cad_user
DB_PASSWORD=cad_password
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL Docker Settings
POSTGRES_DB=cad_analyzer_dev
POSTGRES_USER=cad_user
POSTGRES_PASSWORD=cad_password

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===========================================
# CELERY CONFIGURATION
# ===========================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===========================================
